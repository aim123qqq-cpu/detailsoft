{
  "expo": {
    "name": "DetailFlow",
    "slug": "detailflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "detailflow",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b1016",
    "ios": {
      "bundleIdentifier": "ru.detailflow.app",
      "supportsTablet": true
    },
    "android": {
      "package": "ru.detailflow.app",
      "versionCode": 10,
      "adaptiveIcon": {
        "backgroundColor": "#0b1016",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b1016",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "DetailFlow снимает автомобиль при приёмке и фото повреждений.",
          "photosPermission": "DetailFlow прикладывает фото из галереи к приёмке автомобиля.",
          "microphonePermission": false
        }
      ],
      "./plugins/with-release-signing.js",
      "./plugins/with-cleartext-traffic.js",
      "expo-sharing",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
