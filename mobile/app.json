{
  "expo": {
    "name": "DetailFlow",
    "slug": "detailflow",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "detailflow",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0b1016",
    "ios": {
      "bundleIdentifier": "ru.detailflow.app",
      "supportsTablet": true
    },
    "android": {
      "package": "ru.detailflow.app",
      "versionCode": 11,
      "adaptiveIcon": {
        "backgroundColor": "#0b1016",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b1016",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "DetailFlow снимает автомобиль при приёмке и фото повреждений.",
          "photosPermission": "DetailFlow прикладывает фото из галереи к приёмке автомобиля.",
          "microphonePermission": false
        }
      ],
      "./plugins/with-release-signing.js",
      "./plugins/with-cleartext-traffic.js",
      "expo-sharing",
      "expo-sqlite",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Manrope",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Manrope_300Light.ttf",
                    "weight": 300
                  },
                  {
                    "path": "./assets/fonts/Manrope_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Manrope_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Manrope_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Manrope_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Manrope_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Manrope_300Light.ttf",
              "./assets/fonts/Manrope_400Regular.ttf",
              "./assets/fonts/Manrope_500Medium.ttf",
              "./assets/fonts/Manrope_600SemiBold.ttf",
              "./assets/fonts/Manrope_700Bold.ttf",
              "./assets/fonts/Manrope_800ExtraBold.ttf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
