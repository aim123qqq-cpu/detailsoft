{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@df/shared/*": [
        "../src/shared/*"
      ],
      "@df/types": [
        "../src/types.ts"
      ],
      "@df/offline/*": [
        "../src/offline/*"
      ],
      "@df/apiError": [
        "../src/apiError.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
