# Copy to .env (it is git-ignored) and fill in. `pnpm start` / `pnpm dev` load it automatically.
# Full list and deployment notes: docs/DEPLOY.md
# Telegram: token from @BotFather. MAX: token from business.max.ru → Чат-боты → Настройки.
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=
# Sign-in by email: a code by letter, sent through a mailbox's SMTP over TLS. For mail.ru: smtp.mail.ru, port 465,
# the full address as the user and a "password for external apps" (mail settings → Безопасность), not the mailbox password.
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM= (defaults to SMTP_USER)
# Backups: a copy before every start (before migrations) and every N hours; 0 disables the timer.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
# BACKUP_DIR=data/backups
# Set to false to remove demo access (the sign-in screen then has no "demo" button).
DEMO_AUTH=true
# Set to false in production so no demo center with sample data is created.
SEED_DEMO=true
# PORT=4173
# HOST=127.0.0.1
# DATABASE_PATH=data/detailflow.db
