  "heading_like_paragraphs_not_heading_style": [
    {
      "para_index": 46,
      "text": "\u0438\u043c\u0435\u043d\u0443\u0435\u043c\u043e\u0435  \u0432 \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u043c \"\u041e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044f\", \u0432 \u043b\u0438\u0446\u0435  \u0420\u0435\u043a\u0442\u043e\u0440\u0430\t\t\t\t\t,",
      "style": "Normal"
    },
    {
      "para_index": 47,
      "text": "\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0433\u043e \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0438 \t\t\u0423\u0441\u0442\u0430\u0432\u0430,",
      "style": "Normal"
    },
    {
      "para_index": 49,
      "text": "1. \u041f\u0440\u0435\u0434\u043c\u0435\u0442 \u0414\u043e\u0433\u043e\u0432\u043e\u0440\u0430",
      "style": "Normal"
    },
    {
      "para_index": 53,
      "text": "2. \u041f\u0440\u0430\u0432\u0430 \u0438 \u043e\u0431\u044f\u0437\u0430\u043d\u043d\u043e\u0441\u0442\u0438 \u0421\u0442\u043e\u0440\u043e\u043d",
      "style": "Normal"
    },
    {
      "para_index": 86,
      "text": "3. \u0421\u0440\u043e\u043a \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0430",
      "style": "Normal"
    },
    {
      "para_index": 88,
      "text": "4. \u0417\u0430\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f",
      "style": "Normal"
    },
    {
      "para_index": 99,
      "text": "\u0410\u0434\u0440\u0435\u0441\u0430, \u0440\u0435\u043a\u0432\u0438\u0437\u0438\u0442\u044b \u0438 \u043f\u043e\u0434\u043f\u0438\u0441\u0438 \u0421\u0442\u043e\u0440\u043e\u043d",
      "style": "Normal"
    },
    {
      "para_index": 196,
      "text": "\u0421\u041e\u0412\u041c\u0415\u0421\u0422\u041d\u042b\u0419  \u0420\u0410\u0411\u041e\u0427\u0418\u0419 \u0413\u0420\u0410\u0424\u0418\u041a (\u041f\u041b\u0410\u041d) \u041f\u0420\u0410\u041a\u0422\u0418\u0427\u0415\u0421\u041a\u041e\u0419 \u041f\u041e\u0414\u0413\u041e\u0422\u041e\u0412\u041a\u0418",
      "style": "Default"
    },
    {
      "para_index": 220,
      "text": "\u0414\u041d\u0415\u0412\u041d\u0418\u041a \u041f\u0420\u0410\u041a\u0422\u0418\u0427\u0415\u0421\u041a\u041e\u0419 \u041f\u041e\u0414\u0413\u041e\u0422\u041e\u0412\u041a\u0418",
      "style": "Normal"
    },
    {
      "para_index": 227,
      "text": "\u0421\u0442\u0443\u0434\u0435\u043d\u0442\u043a\u0430    ",
      "style": "Normal"
    },
    {
      "para_index": 258,
      "text": "\u0421\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0435 \u043e\u0442\u0447\u0435\u0442\u0430",
      "style": "\u041e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u0442\u0435\u043a\u0441\u04423"
    },
    {
      "para_index": 278,
      "text": "\u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435",
      "style": "Normal"
    },
    {
      "para_index": 317,
      "text": "\u0427\u0430\u0441\u0442\u044c 1",
      "style": "Normal"
    },
    {
      "para_index": 332,
      "text": "\u0414\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c:\u00a0\u0417\u0430\u043c. \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u0430 \u043f\u043e \u0443\u0447\u0435\u0431\u043d\u043e \u2014 \u0432\u043e\u0441\u043f\u0438\u0442\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u00a0\u00a0",
      "style": "Body Text"
    },
    {
      "para_index": 345,
      "text": "\u0414\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c:\u00a0\u0417\u0430\u043c. \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u0430 \u043f\u043e \u0443\u0447\u0435\u0431\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u00a0\u00a0",
      "style": "Body Text"
    },
    {
      "para_index": 378,
      "text": "\u0423\u0447\u0435\u0431\u043d\u043e-\u0432\u0441\u043f\u043e\u043c\u043e\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b",
      "style": "Body Text"
    },
    {
      "para_index": 394,
      "text": "\u0427\u0430\u0441\u0442\u044c 2",
      "style": "Normal"
    },
    {
      "para_index": 395,
      "text": "2. \u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c",
      "style": "Normal"
    },
    {
      "para_index": 422,
      "text": "3. \u041a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u0430\u044f \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c",
      "style": "Normal"
    },
    {
      "para_index": 452,
      "text": "4. \u041f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u043e-\u043f\u0435\u0434\u0430\u0433\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043f\u0440\u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u0435",
      "style": "Normal"
    }
